<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      xunit.v3 4.x defaults to Microsoft.Testing.Platform, which `dotnet test` on the .NET 10 SDK
      only runs after a global.json opt-in. We stay on VSTest (Microsoft.NET.Test.Sdk), which
      coverlet.collector and the Category trait filter in testing.md rely on.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OnboardingPortal.Api\OnboardingPortal.Api.csproj" />
    <ProjectReference Include="..\..\src\OnboardingPortal.Application\OnboardingPortal.Application.csproj" />
    <ProjectReference Include="..\..\src\OnboardingPortal.Domain\OnboardingPortal.Domain.csproj" />
    <ProjectReference Include="..\..\src\OnboardingPortal.Infrastructure\OnboardingPortal.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\OnboardingPortal.Worker\OnboardingPortal.Worker.csproj" />
  </ItemGroup>

</Project>
